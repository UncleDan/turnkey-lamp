#!/bin/bash -e
# rector by Daniele Lolli (UncleDan) feat. Claude AI - Release 1.0 - 2026-11-10 16-01-58
#
# Run Rector (installed in /opt/php5to8-tools) with the default PHP 8 CLI.
# short_open_tag is forced on, otherwise code inside '<?' tags is read as HTML
# and silently left untouched.

exec php -d short_open_tag=On -d memory_limit=2G \
    /opt/php5to8-tools/vendor/bin/rector "$@"
