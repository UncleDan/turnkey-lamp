#!/bin/bash -ex
# php-dual by Daniele Lolli (UncleDan) feat. Claude AI - Release 1.0 - 2026-11-10 16-01-58
#
# Switch Apache from mod_php (prefork) to PHP-FPM (event) and serve two apps:
#   - /var/www/app-php5 on https://<host>:5443 with PHP 5.6 (legacy)
#   - /var/www/app-php8 on https://<host>:8443 with PHP 8 (Rector upgraded copy)
# The TurnKey landing page and Adminer keep using the default PHP 8 FPM pool.
#
# Refs:
#   https://httpd.apache.org/docs/2.4/mod/mod_proxy_fcgi.html
#   https://www.php.net/manual/en/install.fpm.configuration.php

APP_TIMEZONE=${APP_TIMEZONE:-Europe/Rome}
# most legacy PHP 5 apps use '<?' tags; set 'off' if the app prints '<?xml'
# from plain HTML/templates (it would be parsed as PHP code)
SHORT_OPEN_TAG=${SHORT_OPEN_TAG:-on}
PHP5_V=5.6
PHP8_V=$(find /etc/php -mindepth 1 -maxdepth 1 -name '8.*' -printf '%f\n' \
            | sort -V | tail -n1)
[[ -n "$PHP8_V" ]] || { echo "fatal: PHP 8 not found in /etc/php" >&2; exit 1; }
[[ -d /etc/php/$PHP5_V/fpm ]] || { echo "fatal: php$PHP5_V-fpm missing" >&2; exit 1; }

# keep Debian's PHP 8 as the default 'php' CLI (php5.6 stays available as php5.6)
update-alternatives --set php "/usr/bin/php$PHP8_V"

# --- Apache: mod_php/prefork -> PHP-FPM/event (also allows HTTP/2) ---------
a2dismod -f "php$PHP8_V" || true
a2dismod -f mpm_prefork
a2enmod mpm_event proxy_fcgi setenvif rewrite
a2enmod http2 || true
a2enconf "php$PHP8_V-fpm"
a2disconf "php$PHP5_V-fpm" 2>/dev/null || true
# threaded MPM: use mod_cgid instead of mod_cgi
a2dismod -f cgi || true
a2enmod cgid

# --- directories -------------------------------------------------------------
install -d -o www-data -g www-data -m 0755 /var/log/php
for app in app-php5 app-php8; do
    install -d -o root -g root -m 0755 "/var/www/$app"
    install -d -o www-data -g www-data -m 1733 "/var/lib/php/sessions-$app"
done
cat > /var/www/app-php5/index.php <<'EOF'
<?php /* TKL-PHP5TO8-PLACEHOLDER - replace with the legacy PHP 5 application */ ?>
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>App PHP 5 (legacy)</title></head>
<body><h1>Legacy app vhost</h1>
<p>PHP <?php echo PHP_VERSION; ?> - document root: <?php echo __DIR__; ?></p>
<p>Copy the legacy application here, then run <code>tkl-php5to8 check</code>.</p>
</body></html>
EOF
sed -e 's|replace with the legacy PHP 5 application|created by tkl-php5to8 migrate|' \
    -e 's|App PHP 5 (legacy)|App PHP 8 (upgraded)|' \
    -e 's|Legacy app vhost|Upgraded app vhost|' \
    -e 's|Copy the legacy application here, then run <code>tkl-php5to8 check</code>.|Populated by <code>tkl-php5to8 migrate</code>.|' \
    /var/www/app-php5/index.php > /var/www/app-php8/index.php

# --- PHP-FPM pools -----------------------------------------------------------
write_pool() {
    local ver=$1 app=$2 reporting=$3
    cat > "/etc/php/$ver/fpm/pool.d/$app.conf" <<EOF
; $app - PHP $ver pool for /var/www/$app (generated by conf.d/php-dual)
[$app]
user = www-data
group = www-data
listen = /run/php/$app.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 30s
pm.max_requests = 500
chdir = /var/www/$app
security.limit_extensions = .php .php5 .phtml

; never show errors to visitors (keeps the pages looking the same), log them all
php_admin_flag[display_errors] = off
php_admin_flag[display_startup_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/php/$app.error.log
php_value[error_reporting] = $reporting

; legacy friendly defaults - identical on both versions
php_admin_flag[short_open_tag] = $SHORT_OPEN_TAG
php_admin_value[date.timezone] = $APP_TIMEZONE
php_admin_value[default_charset] = UTF-8
php_admin_value[memory_limit] = 128M
php_admin_value[post_max_size] = 16M
php_admin_value[upload_max_filesize] = 8M
php_admin_value[session.save_path] = /var/lib/php/sessions-$app
php_admin_value[session.gc_probability] = 1
EOF
}
write_pool "$PHP5_V" app-php5 'E_ALL & ~E_DEPRECATED & ~E_STRICT & ~E_NOTICE'
write_pool "$PHP8_V" app-php8 'E_ALL'
# PHP 5.6 only serves the legacy app: disable its default 'www' pool
if [[ -f /etc/php/$PHP5_V/fpm/pool.d/www.conf ]]; then
    mv /etc/php/$PHP5_V/fpm/pool.d/www.conf /etc/php/$PHP5_V/fpm/pool.d/www.conf.disabled
fi

# --- Apache vhosts -----------------------------------------------------------
write_vhost() {
    local app=$1 port=$2 ver=$3
    cat > "/etc/apache2/sites-available/$app.conf" <<EOF
# $app - PHP $ver on port $port (generated by conf.d/php-dual)
<VirtualHost *:$port>
    SSLEngine on
    ServerAdmin webmaster@localhost
    # Name based access is also possible - set a DNS name and uncomment:
    #ServerName $app.example.com
    DocumentRoot /var/www/$app
    DirectoryIndex index.php index.html index.htm

    ErrorLog \${APACHE_LOG_DIR}/$app-error.log
    CustomLog \${APACHE_LOG_DIR}/$app-access.log combined

    # vhost level handler overrides the global php$PHP8_V-fpm one
    <FilesMatch ".+\.(php|php5|phtml)$">
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:unix:/run/php/$app.sock|fcgi://$app"
        </If>
    </FilesMatch>

    <Directory /var/www/$app/>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>
EOF
    echo "Listen $port" >> /etc/apache2/ports.conf
    a2ensite "$app"
}
write_vhost app-php5 5443 "$PHP5_V"
write_vhost app-php8 8443 "$PHP8_V"

# logrotate for the per app PHP error logs
cat > /etc/logrotate.d/php-apps <<'EOF'
/var/log/php/*.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
}
EOF

# Webmin "PHP Configuration" module: list the FPM and CLI php.ini files
WEBMIN_PHP_CONF=/etc/webmin/phpini/config
if [[ -f "$WEBMIN_PHP_CONF" ]]; then
    TAB=$'\t'
    cat > "$WEBMIN_PHP_CONF" <<EOF
php_ini=/etc/php/$PHP8_V/fpm/php.ini=PHP $PHP8_V FPM (landing page, Adminer, app-php8)${TAB}/etc/php/$PHP5_V/fpm/php.ini=PHP $PHP5_V FPM (app-php5)${TAB}/etc/php/$PHP8_V/cli/php.ini=PHP $PHP8_V CLI${TAB}/etc/php/$PHP5_V/cli/php.ini=PHP $PHP5_V CLI
EOF
fi

systemctl enable "php$PHP8_V-fpm" "php$PHP5_V-fpm"
